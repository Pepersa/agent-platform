# ============================================================================
# .gitignore — 本地优先 Agent 平台的忽略规则
#
# 设计原则：
#   1) 只忽略「可再生成」或「仅本机有意义」的文件，保证 clone 后的仓库可直接运行。
#   2) 文档、图片、配置样例一律保留（docs/_verify/*.png、obs-08-repomap.png、*.md 等）。
#   3) 每个规则块都用中文注释写清楚「为什么」要忽略它，方便后来者理解取舍。
# ============================================================================


# ---------------------------------------------------------------------------
# 1. 打包产物
# ---------------------------------------------------------------------------
# dist/ 是 PyInstaller --onedir 打出来的桌面包，约 7.65 GB / 21000+ 文件，
# 体积巨大且可随时用 deploy/ 里的脚本重新构建，不应进版本库。
dist/
# build/ 是 PyInstaller 的中间工作目录（约 328 MB），每次打包都会重新生成。
build/
# 各种一次性打包输出目录（*.spec 产物目录等）
*.spec.bak


# ---------------------------------------------------------------------------
# 2. 运行时数据与状态
# ---------------------------------------------------------------------------
# data/ 保存的是运行期状态而非源码：sessions.db / workspace.db / audit.db /
# kb/chunks.db（SQLite）、logs/、screenshots/、_tmp/、models.json、
# custom_tools.json 等。这些都是每次启动后重新生成的本地状态，
# 而且含有用户本机的绝对路径与运行痕迹，入库会造成巨大的无意义 diff。
data/


# ---------------------------------------------------------------------------
# 3. 缓存目录
# ---------------------------------------------------------------------------
# .cache/ 里是 pip 下载缓存和 HuggingFace 模型缓存（embedding / reranker 权重），
# 体积大且可按需重新下载。
.cache/
# HuggingFace 缓存的另一种常见位置
.huggingface/
# 通用编译缓存
.cache_dir/


# ---------------------------------------------------------------------------
# 4. Python 编译产物
# ---------------------------------------------------------------------------
# __pycache__/ 存放 .pyc 字节码，由解释器自动生成，与源码不同步。
__pycache__/
*.py[cod]
*$py.class
# C 扩展编译出来的 .so/.pyd
*.so
# egg-info 是打包元数据，随版本变化而变化。
*.egg-info/
*.egg
# pip 安装产物目录
.Python
pip-log.txt
pip-delete-this-directory.txt


# ---------------------------------------------------------------------------
# 5. 虚拟环境
# ---------------------------------------------------------------------------
# .venv/ 与 venv/ 包含本地安装的全部第三方依赖，体积大且与具体机器绑定，
# 应该由 requirements.txt 重新安装生成。
.venv/
venv/
env/
ENV/
# 虚拟环境内的配置片段
*.egg-info
# pyvenv.cfg
pyvenv.cfg


# ---------------------------------------------------------------------------
# 6. 环境变量与本地密钥
# ---------------------------------------------------------------------------
# .env 及其变体可能包含 API Key、本机路径等敏感信息，绝不能提交。
# 注意：.env.example 是提供给他人的配置样例，必须保留，所以这里显式反忽略。
.env
.env.*
!.env.example


# ---------------------------------------------------------------------------
# 7. IDE / 编辑器配置
# ---------------------------------------------------------------------------
# .idea/ 与 .vscode/ 是个人编辑器偏好（含本地调试路径、插件列表），与项目无关。
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
# vim / emacs / sublime 的临时文件
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
# JetBrains 的运行配置
*.iml


# ---------------------------------------------------------------------------
# 8. 操作系统垃圾文件
# ---------------------------------------------------------------------------
# Windows / macOS 在目录里留下的系统元数据文件，纯噪音。
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/


# ---------------------------------------------------------------------------
# 9. 测试与类型检查缓存
# ---------------------------------------------------------------------------
# 测试 / 覆盖率 / 类型检查 / lint 的中间产物，每次运行都会重写。
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage.json
.tox/
.nox/
.mypy_cache/
.dmypy.json
.dmypy.jsonl
.pyre/
.pytype/
.ruff_cache/
.pyright/
# 测试临时目录
tests/.tmp/


# ---------------------------------------------------------------------------
# 10. 日志与临时文件
# ---------------------------------------------------------------------------
# 运行期日志体积会无限增长，属于噪音。
*.log
logs/
# 临时文件与备份文件
*.tmp
*.temp
*.bak
*.orig
*.swp
*~
# 打包/中间产物
*.pid
*.seed


# ---------------------------------------------------------------------------
# 11. 本项目特有的临时目录
# ---------------------------------------------------------------------------
# obstmp/ 与 lz/ 是开发调试时用的草稿/临时产物目录，内容随时会重写。
obstmp/
lz/
# 调试截图目录
.cursor_shots/


# ---------------------------------------------------------------------------
# 12. 模型权重文件
# ---------------------------------------------------------------------------
# GGUF / safetensors / onnx 是模型权重，单个动辄数 GB，
# 应该由 scripts/ 里的下载脚本从 HuggingFace 拉取，而不是进 Git。
*.gguf
*.safetensors
*.onnx
*.bin
*.pt
*.pth
*.h5
*.pb


# ---------------------------------------------------------------------------
# 13. 编译出的二进制与可执行文件
# ---------------------------------------------------------------------------
# 本地编译出来的 exe/dll/pyd 属于构建产物，应由源码重新编译得到。
*.exe
*.dll
*.pyd
*.pdb
*.ilk
*.obj
# PyInstaller / Nuitka 等打包产生的可执行目录
*.spec
!*.spec.py


# ---------------------------------------------------------------------------
# 14. 明确保留（防止被上面的通配规则误伤）
# ---------------------------------------------------------------------------
# 下面这些是「刻意」提交的资产，用反忽略规则显式声明，避免被宽泛规则排除：
#   - docs/_verify/*.png 与 obs-08-repomap.png：文档校验截图，必须能在线查看
#   - *.md / requirements.txt / config/ / deploy/ / scripts/ / tools/：项目主体
#   - .env.example：配置样例
!docs/_verify/*.png
!obs-08-repomap.png
!*.md
!.env.example
!requirements.txt
!config/
!deploy/
!scripts/
!tools/


# ---------------------------------------------------------------------------
# 15. 显式取消忽略的常见误伤项
# ---------------------------------------------------------------------------
# 上述 14 节的反忽略规则要求 git 先"取消目录整体排除"，
# 这里把关键目录显式重新纳入追踪范围。
!.github/
!config/
!deploy/
!docs/
!scripts/
!tools/
!agent_platform/
