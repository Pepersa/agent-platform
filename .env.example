# ---- 本地 Agent 平台环境变量 ----
# 复制为 .env 后由应用加载（Windows 原生，不依赖 docker-compose）

# ---- 数据目录（**可整体外置到任意盘符**）----
# 运行时数据（sessions.db / kb/chunks.db / audit.db / workspace.db /
# models.json / 日志 / 截图产物）都落在这个目录下。
# 留空 = 用项目默认 <repo>/data（与改造前完全一致）。
# 想搬到别的盘就填绝对路径，例如 D:\agent-data。
# 迁移已有数据：python scripts\migrate_data_dir.py --to D:\agent-data --dry-run
AGENT_DATA_DIR=

# ---- 主 LLM：gpt-oss-20b（GPU 全 offload，复杂推理 / 工具调用）----
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gpt-oss-20b
LLM_REASONING_EFFORT=medium
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=180

# ---- 上下文窗口（必须与 llama-server 的 -c 一致）----
# deploy\start_servers.ps1 默认 -CtxSize 32768。
# gpt-oss-20b 用 GQA + q8_0 KV 量化，KV cache 仅 24 KiB/token，
# 32K 上下文只要 ~0.75 GB 显存，扩窗口的边际成本极低。
# ★ 8192 太小：改一个 200 行的类（连同 system prompt + 工具 schema）
#   就会超窗，模型端直接 400。改大窗口前请先确认显存够用
#   （nvidia-smi 看剩余显存）。
LLM_CONTEXT_WINDOW=32768

# ---- 次 LLM：Qwen2.5-14B（CPU 驻留，中文问答 / 用例生成 / LLM-as-Judge）----
LLM_SECONDARY_BASE_URL=http://127.0.0.1:8081/v1
LLM_SECONDARY_MODEL=qwen2.5-14b

# ---- 审计 ----
# 有 PostgreSQL 就填 DSN（append-only）；留空则降级为 data/audit/audit.jsonl
AUDIT_DSN=
AUDIT_FALLBACK_PATH=./data/audit/audit.jsonl

# ---- 向量库 ----
# sqlite = 本地降级路径（默认，无需数据库）；pg = pgvector
VECTOR_STORE=sqlite
PG_DSN=postgresql://agent:agent@127.0.0.1:5432/agentdb
CHUNK_DB_PATH=./data/chunks.sqlite3

# ---- 检索参数（严格对齐 docs\01 §3.1，不要随意改）----
RECALL_N=50
TOP_K=6
RRF_K=60
MIN_SCORE_THRESHOLD=0.35
EMBEDDING_DIM=1024
# bge-m3 / reranker 本地权重目录（用 scripts\fetch_bge_shards.py 下载）
BGE_M3_PATH=E:\model\models\bge-m3
BGE_RERANKER_PATH=E:\model\models\bge-reranker-v2-m3
EMBED_BACKEND=auto
RERANK_BACKEND=auto

# ---- 预算闸门（docs\01 §2.4）----
BUDGET_MAX_ROUNDS=8
BUDGET_MAX_TOKENS=60000
BUDGET_MAX_TOOL_CALLS=24
BUDGET_MAX_SECONDS=900
MAX_TOKENS_PER_TOOL_RESULT=4000

# ---- 知识库文档目录 ----
DOCS_DIR=./data/docs
ARTIFACTS_DIR=./data/artifacts
